# ============================================
# Birim Web - Environment Variables Template
# ============================================
# 
# Bu dosya, projenin calismasi icin gerekli environment variable'larin
# sablonunu icerir. Yeni bir gelistirici icin:
# 
# 1. Bu dosyayi kopyalayin: cp .env.example .env
# 2. Asagidaki degerleri doldurun
# 3. Uygulamayi yeniden baslatin: npm run dev
#
# ============================================

# --------------------------------------------
# Sanity CMS Configuration
# --------------------------------------------
# Sanity CMS entegrasyonu icin gerekli ayarlar
# Token almak icin: https://sanity.io/manage

VITE_SANITY_PROJECT_ID=your_sanity_project_id_here
VITE_SANITY_DATASET=your_sanity_dataset_here
VITE_SANITY_API_VERSION=2025-01-01

# Sanity API Token (Editor veya Admin yetkisi gerekli)
# GÜVENLİK NOTU: VITE_ prefix'i olmayan bu token sunucu tarafında (api/) çalışır, istemciye sızmaz.
# Token almak icin:
# 1. https://sanity.io/manage adresine gidin
# 2. Projenizi secin (wn3a082f)
# 3. API sekmesine gidin
# 4. Add API token butonuna tiklayin
# 5. Editor veya Admin yetkisi secin
# 6. Token'i buraya yapistirin
SANITY_TOKEN=

# Local fallback kullanimi (development icin)
# true: Sanity yoksa local storage kullanilir
# false: Sadece Sanity kullanilir
VITE_ENABLE_LOCAL_FALLBACK=true

# --------------------------------------------
# Cloudflare R2 Storage (CDN)
# --------------------------------------------
# R2 Workers CDN URL - hızlı, cache'li, rate limit yok
# .r2.dev yerine Workers CDN kullanılır (daha hızlı, rate limit yok)
VITE_R2_DOMAIN=your_r2_domain_here

# Orijinal .r2.dev URL'si (Sanity'deki eski URL'leri Workers CDN'e yeniden yazmak için)
VITE_R2_ORIGIN_DOMAIN=your_r2_origin_domain_here

# --------------------------------------------
# Error Reporting (Sentry)
# --------------------------------------------
# Hata raporlama icin Sentry DSN
# Sentry projesi olusturup DSN'i buraya ekleyin
# Bos birakilirsa sadece console'a log yazilir

VITE_SENTRY_DSN=

# --------------------------------------------
# Analytics
# --------------------------------------------
# Google Analytics ve Plausible Analytics entegrasyonu

# Google Analytics Tracking ID (orn: G-XXXXXXXXXX)
VITE_GA_ID=

# PostHog Analytics
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=https://us.i.posthog.com

# Plausible Analytics Domain (orn: yourdomain.com)
VITE_PLAUSIBLE_DOMAIN=

# Analytics'i aktif etmek icin (true/false)
VITE_ENABLE_ANALYTICS=true

# --------------------------------------------
# Site Configuration
# --------------------------------------------
# Site genel ayarlari

# Site URL (sitemap ve robots.txt icin)
# Production'da gercek domain ile degistirin
VITE_SITE_URL=https://www.birim.com

# Maintenance Mode (Bakim Modu)
# true: Yakinda sayfasi gosterilir
# false: Normal site gosterilir
# Not: Development modunda otomatik olarak false'dur
VITE_MAINTENANCE_MODE=false

# Maintenance Mode Bypass Secret
# Maintenance mode aktifken bu secret ile erisim saglanabilir
# URL: ?bypass=your_secret_here
VITE_MAINTENANCE_BYPASS_SECRET=

# --------------------------------------------
# Google Gemini API (AI Room Planner - Nano Banana)
# --------------------------------------------
# Google AI Studio'dan alinan Gemini API Key
GEMINI_API_KEY=your_gemini_api_key_here

# ============================================
# Notlar
# ============================================
#
# - Tum degerler opsiyoneldir (bos birakilabilir)
# - Production'da mutlaka VITE_SITE_URL ayarlanmalidir
# - SANITY_TOKEN olmadan uye kayitlari calismaz (local storage'a kaydedilir)
# - Sentry DSN olmadan hata raporlama calismaz (sadece console)
# - Analytics ID'leri olmadan analytics calismaz
#
# ============================================