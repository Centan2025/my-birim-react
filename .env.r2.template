# Cloudflare R2 & Sanity Migration Configuration
# Bu dosyayı .env.local olarak kaydedin veya mevcut .env.local dosyanıza ekleyin.

# 1. Cloudflare R2 Ayarları
# Cloudflare Dashboard -> R2 -> Manage R2 API Tokens kısmından alabilirsiniz.
R2_ACCOUNT_ID=__BURAYA_CLOUDFLARE_ACCOUNT_ID_GELECEK__
R2_ACCESS_KEY_ID=__BURAYA_CLOUDFLARE_ACCESS_KEY_ID_GELECEK__
R2_SECRET_ACCESS_KEY=__BURAYA_CLOUDFLARE_SECRET_ACCESS_KEY_GELECEK__
R2_BUCKET_NAME=__BURAYA_BUCKET_ISMI_GELECEK__ (örn: mobilya-assets)

# 2. Frontend için Public URL (Image Resizing)
# Cloudflare Dashboard -> R2 -> Bucket -> Settings -> Public Access -> Custom Domains
VITE_R2_DOMAIN=https://__BURAYA_CLOUDFLARE_WORKER_DOMAIN_GELECEK__

# 3. Sanity Ayarları (Migration Scripti İçin)
# Sanity Manage -> API -> Tokens -> Add New Token (Write hakkı gerekli)
SANITY_PROJECT_ID=wn3a082f
SANITY_DATASET=production
SANITY_TOKEN=__BURAYA_SANITY_WRITE_TOKEN_GELECEK__
